{
	"permissions": {
		"deny": [
			"Bash(npx *)",
			"Bash(npm *)",
			"Bash(pnpm *)",
			"Bash(yarn *)",
			"Bash(gh pr comment *)",
			"Bash(gh issue comment *)",
			"Bash(gh pr review *)"
		],
		"ask": [
			"Bash(bun add *)",
			"Bash(bun a *)",
			"Bash(bun install *)",
			"Bash(bun i *)",
			"Bash(bun remove *)",
			"Bash(bun rm *)",
			"Bash(bun r *)",
			"Bash(bun uninstall *)",
			"Bash(bun update *)",
			"Bash(bun patch *)",
			"Bash(bun patch-commit *)",
			"Bash(bun pm pkg *)",
			"Bash(bun pm version *)",
			"Bash(bun pm trust *)"
		]
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"if": "Bash(git *)",
						"command": "bun \"${CLAUDE_PROJECT_DIR}/scripts/git-guard.ts\" || exit 2"
					}
				]
			}
		]
	}
}
