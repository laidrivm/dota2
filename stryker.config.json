{
	"$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
	"mutate": [
		"src/model.ts",
		"src/model-terms.ts",
		"src/cm/engine/**/*.ts",
		"!src/cm/engine/**/*.test.ts"
	],
	"commandRunner": {
		"command": "bun test src/model src/cm/engine"
	},
	"thresholds": {
		"break": null
	},
	"reporters": ["clear-text", "progress", "json"],
	"jsonReporter": {
		"fileName": "reports/mutation/mutation.json"
	},
	"tsconfigFile": "tsconfig.stryker-none.json",
	"ignorePatterns": [".claude", "spec-inbox"]
}
