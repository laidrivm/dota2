# Every variable a run reads, with no value for any of them. Copy to `.env`
# and fill it in; `.gitignore` covers `.env*` and excepts this file alone.
#
# A key that has been exposed is rotated at its source — nothing in this
# repository can undo that for it.

# The STRATZ statistics API token. A run with this unset or empty fails before
# its first request. Issued at https://stratz.com/api.
STRATZ_API_KEY=

# Where the snapshot database answers, as a libpq connection string
# (postgres://user:password@host:port/database). A run with this unset fails
# before it opens a connection; the unit and end-to-end suites leave it unset
# and run on the served fixture instead.
DATABASE_URL=

# Where the published bundle is written, which is the directory the serving
# route resolves `snapshot.json` out of. A run with this unset fails before it
# opens a connection, the export having nowhere to publish to.
BUNDLE_DIR=

# Where the mirrored hero images land, which is the directory the icon route
# serves. Read only by a whole run: the export invoked on its own writes no
# image and does not ask for it.
ICONS_DIR=
